# ==============================================================================
# Requirement Collision Engine (RCE) — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' if you wish to override local runtime settings.
# Notice: No sensitive secrets, API keys, or credentials are required.
# ==============================================================================

# Application Environment (development, testing, production)
RCE_ENV=development

# Logging Verbosity Level (DEBUG, INFO, WARNING, ERROR)
RCE_LOG_LEVEL=INFO

# Python Workspace Resolution Path (defaults to current directory)
PYTHONPATH=.

# Default Graph Traversal Depth for Change-Impact Analysis (Hop count)
RCE_DEFAULT_MAX_DEPTH=3

# Output Directory for Exported Reports and Analysis JSON Artifacts
RCE_OUTPUT_DIR=./reports
